%{
#include "y.tab.h"
%}

%%

"for"                           return FOR;

[a-zA-Z_][a-zA-Z0-9_]*          return ID;
[0-9]+                          return NUM;

"++"                            return INC;
"--"                            return DEC;

"<="                            return LE;
">="                            return GE;
"=="                            return EQ;
"!="                            return NE;

[<>=;(){}+\-*/]                 return yytext[0];

[ \t\n]                         ;

.                               return yytext[0];

%%

int yywrap()
{
    return 1;
}


%{
#include <stdio.h>

int yylex(void);
void yyerror(char *s);
%}

%token FOR ID NUM LE GE EQ NE INC DEC

%left '+' '-'
%left '*' '/'

%%

stmt:
    FOR '(' init ';' cond ';' upd ')' '{' '}'
    {
        printf("Valid FOR statement\n");
    }
    ;

init:
    ID '=' expr
    ;

cond:
    expr relop expr
    ;

relop:
    '<'
    | '>'
    | LE
    | GE
    | EQ
    | NE
    ;

upd:
    ID INC
    | ID DEC
    | ID '=' expr
    ;

expr:
    expr '+' expr
    | expr '-' expr
    | expr '*' expr
    | expr '/' expr
    | '(' expr ')'
    | ID
    | NUM
    ;

%%

void yyerror(char *s)
{
    printf("Invalid FOR statement\n");
}

int main()
{
    printf("Enter FOR statement:\n");
    yyparse();
    return 0;
}
