#include <stdio.h>
#include <string.h>

#define MAX 40

int n,m,notrans,f,t,inp,fn;
char states[MAX],symbol[MAX];
char from,input,to,fin,initialState;

int trans[MAX][MAX][MAX];
int final[MAX],newfinal[MAX];

char dfastates[MAX][MAX];
int dfacount=0;
int dfa[MAX][MAX];

void sortset(char st[])
{
    int len=strlen(st);

    for(int i=0;i<len-1;i++)
    {
        for(int j=i+1;j<len;j++)
        {
            if(st[i]>st[j])
            {
                char temp=st[j];
                st[j]=st[i];
                st[i]=temp;
            }
        }
    }
}

int exists(char st[])
{
    for(int i=0;i<dfacount;i++)
    {
        if(strcmp(dfastates[i],st)==0)
        {
            return i;
        }
    }

    return -1;
}

void addset(char st[])
{
    if(exists(st)==-1)
    {
        strcpy(dfastates[dfacount],st);
        dfacount++;
    }
}

int stateindex(char st)
{
    for(int i=0;i<n;i++)
    {
        if(states[i]==st)
        {
            return i;
        }
    }

    return -1;
}

int isfinal(char st[])
{
    for(int i=0;i<strlen(st);i++)
    {
        int index=stateindex(st[i]);

        if(index!=-1 && final[index])
        {
            return 1;
        }
    }

    return 0;
}

int symindex(char st)
{
    for(int i=0;i<m;i++)
    {
        if(symbol[i]==st)
        {
            return i;
        }
    }

    return -1;
}

int main()
{
    printf("Enter number of states\n");
    scanf("%d",&n);

    printf("Enter states\n");

    for(int i=0;i<n;i++)
    {
        scanf(" %c",&states[i]);
    }

    printf("Enter number of symbols\n");
    scanf("%d",&m);

    printf("Enter symbols\n");

    for(int i=0;i<m;i++)
    {
        scanf(" %c",&symbol[i]);
    }

    printf("Enter number of transitions\n");
    scanf("%d",&notrans);

    printf("Enter transitions (From Symbol To)\n");

    for(int i=0;i<notrans;i++)
    {
        scanf(" %c %c %c",&from,&input,&to);

        f=stateindex(from);
        inp=symindex(input);
        t=stateindex(to);

        if(f!=-1 && inp!=-1 && t!=-1)
        {
            trans[f][inp][t]=1;
        }
        else
        {
            printf("Invalid transition\n");
        }
    }

    printf("Enter number of final states\n");
    scanf("%d",&fn);

    printf("Enter final states\n");

    for(int i=0;i<fn;i++)
    {
        scanf(" %c",&fin);

        int j=stateindex(fin);

        if(j!=-1)
        {
            final[j]=1;
        }
        else
        {
            printf("Invalid final state\n");
        }
    }

    // Input initial state

    printf("Enter initial state\n");
    scanf(" %c",&initialState);

    char initial[MAX];

    initial[0]=initialState;
    initial[1]='\0';

    sortset(initial);
    addset(initial);

    // Subset construction

    for(int i=0;i<dfacount;i++)
    {
        for(int j=0;j<m;j++)
        {
            char temp[MAX]="";
            int len=0;

            if(strcmp(dfastates[i],"-")==0)
            {
                strcpy(temp,"-");
            }
            else
            {
                for(int k=0;k<strlen(dfastates[i]);k++)
                {
                    int p=stateindex(dfastates[i][k]);

                    if(p==-1)
                        continue;

                    for(int r=0;r<n;r++)
                    {
                        if(trans[p][j][r])
                        {
                            int found=0;

                            for(int z=0;z<len;z++)
                            {
                                if(temp[z]==states[r])
                                {
                                    found=1;
                                }
                            }

                            if(!found)
                            {
                                temp[len++]=states[r];
                                temp[len]='\0';
                            }
                        }
                    }
                }

                if(len==0)
                {
                    strcpy(temp,"-");
                }
                else
                {
                    sortset(temp);
                }
            }

            addset(temp);

            dfa[i][j]=exists(temp);
        }
    }

    // Identify final DFA states

    for(int i=0;i<dfacount;i++)
    {
        if(isfinal(dfastates[i]))
        {
            newfinal[i]=1;
        }
    }

    // Print DFA transition table

    printf("\nDFA Transition Table\n");

    printf("DFA State");

    for(int i=0;i<m;i++)
    {
        printf("\t%c",symbol[i]);
    }

    printf("\tFinal\n");

    for(int i=0;i<dfacount;i++)
    {
        printf("{%s}",dfastates[i]);

        for(int j=0;j<m;j++)
        {
            printf("\t{%s}",dfastates[dfa[i][j]]);
        }

        if(newfinal[i])
            printf("\tYes\n");
        else
            printf("\tNo\n");
    }

    // Print final DFA states

    printf("\nFinal DFA States: ");

    for(int i=0;i<dfacount;i++)
    {
        if(newfinal[i])
        {
            printf("{%s} ",dfastates[i]);
        }
    }

    printf("\n");

    return 0;
}
